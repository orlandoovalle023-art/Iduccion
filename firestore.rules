rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isApprenticeId(uid) {
      return uid is string && uid.size() >= 16 && uid.size() <= 40 && uid.matches('^apr_[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // True only for Google-authenticated users with verified email (Instructors / Admins)
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'orlandoovalle023@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Validation Blueprints ---
    function isValidAdmin(data) {
      return data.keys().hasAll(['uid', 'note', 'addedBy', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'note', 'addedBy', 'createdAt']) &&
        isValidId(data.uid) &&
        data.note is string && data.note.size() >= 2 && data.note.size() <= 120 &&
        isValidId(data.addedBy) &&
        data.createdAt is timestamp;
    }

    function isValidUser(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'documentType', 'documentNumber',
          'ficha', 'programa', 'role', 'onboardingCompleted',
          'completedModules', 'xpPoints', 'level', 'earnedBadges',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'documentType', 'documentNumber',
          'ficha', 'programa', 'role', 'onboardingCompleted',
          'completedModules', 'xpPoints', 'level', 'earnedBadges',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 100 &&
        data.documentType in ['CC', 'TI', 'CE', 'PPT', 'NA'] &&
        data.documentNumber is string && data.documentNumber.size() >= 4 && data.documentNumber.size() <= 20 && data.documentNumber.matches('^[a-zA-Z0-9\\-]+$') &&
        data.ficha is string && data.ficha.size() >= 4 && data.ficha.size() <= 20 && data.ficha.matches('^[a-zA-Z0-9\\-]+$') &&
        data.programa is string && data.programa.size() >= 3 && data.programa.size() <= 120 &&
        data.role in ['aprendiz', 'instructor'] &&
        data.onboardingCompleted is bool &&
        data.completedModules is list && data.completedModules.size() <= 12 &&
        (data.completedModules.size() == 0 || (data.completedModules[0] is string && data.completedModules[0].size() <= 60)) &&
        data.xpPoints is int && data.xpPoints >= 0 && data.xpPoints <= 100000 &&
        data.level is int && data.level >= 1 && data.level <= 4 &&
        data.earnedBadges is list && data.earnedBadges.size() <= 10 &&
        (data.earnedBadges.size() == 0 || (data.earnedBadges[0] is string && data.earnedBadges[0].size() <= 40)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCohort(data) {
      return data.keys().hasAll(['fichaCode', 'programa', 'jornada', 'status', 'instructorUid', 'instructorName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['fichaCode', 'programa', 'jornada', 'status', 'instructorUid', 'instructorName', 'createdAt', 'updatedAt']) &&
        data.fichaCode is string && data.fichaCode.size() >= 4 && data.fichaCode.size() <= 20 && data.fichaCode.matches('^[a-zA-Z0-9\\-]+$') &&
        data.programa is string && data.programa.size() >= 3 && data.programa.size() <= 120 &&
        data.jornada in ['Diurna', 'Mixta', 'Nocturna', 'Fines de semana', 'Virtual'] &&
        data.status in ['activa', 'archivada'] &&
        isValidId(data.instructorUid) &&
        data.instructorName is string && data.instructorName.size() >= 2 && data.instructorName.size() <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAccessLog(data) {
      return data.keys().hasAll(['uid', 'apprenticeName', 'documentType', 'documentNumber', 'ficha', 'programa', 'action', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'apprenticeName', 'documentType', 'documentNumber', 'ficha', 'programa', 'action', 'createdAt']) &&
        isValidId(data.uid) &&
        data.apprenticeName is string && data.apprenticeName.size() >= 2 && data.apprenticeName.size() <= 100 &&
        data.documentType in ['CC', 'TI', 'CE', 'PPT', 'NA'] &&
        data.documentNumber is string && data.documentNumber.size() >= 4 && data.documentNumber.size() <= 20 && data.documentNumber.matches('^[a-zA-Z0-9\\-]+$') &&
        data.ficha is string && data.ficha.size() >= 4 && data.ficha.size() <= 20 && data.ficha.matches('^[a-zA-Z0-9\\-]+$') &&
        data.programa is string && data.programa.size() >= 3 && data.programa.size() <= 120 &&
        data.action in ['registro', 'ingreso'] &&
        data.createdAt is timestamp;
    }

    function isValidDomainScores(scores) {
      return scores is map &&
        scores.keys().hasAll(['identidad', 'derechosDeberes', 'debidoProceso', 'etapaProductiva']) &&
        scores.keys().hasOnly(['identidad', 'derechosDeberes', 'debidoProceso', 'etapaProductiva']) &&
        scores.identidad is int && scores.identidad >= 0 && scores.identidad <= 100 &&
        scores.derechosDeberes is int && scores.derechosDeberes >= 0 && scores.derechosDeberes <= 100 &&
        scores.debidoProceso is int && scores.debidoProceso >= 0 && scores.debidoProceso <= 100 &&
        scores.etapaProductiva is int && scores.etapaProductiva >= 0 && scores.etapaProductiva <= 100;
    }

    function isValidEvaluation(data) {
      return data.keys().hasAll([
          'uid', 'apprenticeName', 'documentNumber', 'ficha', 'programa',
          'mode', 'totalScore', 'correctCount', 'questionCount',
          'domainScores', 'weakestDomain', 'xpEarned', 'bestStreak',
          'unlockedBadges', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'apprenticeName', 'documentNumber', 'ficha', 'programa',
          'mode', 'totalScore', 'correctCount', 'questionCount',
          'domainScores', 'weakestDomain', 'xpEarned', 'bestStreak',
          'unlockedBadges', 'createdAt'
        ]) &&
        isValidId(data.uid) &&
        data.apprenticeName is string && data.apprenticeName.size() >= 2 && data.apprenticeName.size() <= 100 &&
        data.documentNumber is string && data.documentNumber.size() >= 4 && data.documentNumber.size() <= 20 && data.documentNumber.matches('^[a-zA-Z0-9\\-]+$') &&
        data.ficha is string && data.ficha.size() >= 4 && data.ficha.size() <= 20 && data.ficha.matches('^[a-zA-Z0-9\\-]+$') &&
        data.programa is string && data.programa.size() >= 3 && data.programa.size() <= 120 &&
        data.mode in ['diagnostico', 'integral'] &&
        data.totalScore is int && data.totalScore >= 0 && data.totalScore <= 100 &&
        data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 20 &&
        data.questionCount is int && data.questionCount >= 1 && data.questionCount <= 20 &&
        data.correctCount <= data.questionCount &&
        isValidDomainScores(data.domainScores) &&
        data.weakestDomain is string && data.weakestDomain.size() >= 2 && data.weakestDomain.size() <= 40 &&
        data.xpEarned is int && data.xpEarned >= 0 && data.xpEarned <= 2000 &&
        data.bestStreak is int && data.bestStreak >= 0 && data.bestStreak <= 20 &&
        data.unlockedBadges is list && data.unlockedBadges.size() <= 10 &&
        (data.unlockedBadges.size() == 0 || (data.unlockedBadges[0] is string && data.unlockedBadges[0].size() <= 40)) &&
        data.createdAt is timestamp;
    }

    function isValidVideoSettings(data) {
      return data.keys().hasAll([
          'anthemVideoId', 'anthemTitle', 'anthemDescription',
          'institutionalVideoId', 'institutionalTitle', 'institutionalDescription',
          'updatedBy', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'anthemVideoId', 'anthemTitle', 'anthemDescription',
          'institutionalVideoId', 'institutionalTitle', 'institutionalDescription',
          'updatedBy', 'updatedAt'
        ]) &&
        data.anthemVideoId is string && data.anthemVideoId.size() >= 6 && data.anthemVideoId.size() <= 20 && data.anthemVideoId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.anthemTitle is string && data.anthemTitle.size() >= 3 && data.anthemTitle.size() <= 120 &&
        data.anthemDescription is string && data.anthemDescription.size() <= 300 &&
        data.institutionalVideoId is string && data.institutionalVideoId.size() >= 6 && data.institutionalVideoId.size() <= 20 && data.institutionalVideoId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.institutionalTitle is string && data.institutionalTitle.size() >= 3 && data.institutionalTitle.size() <= 120 &&
        data.institutionalDescription is string && data.institutionalDescription.size() <= 300 &&
        isValidId(data.updatedBy) &&
        data.updatedAt is timestamp;
    }

    function isValidSession(data) {
      return data.keys().hasAll(['sessionCode', 'title', 'ficha', 'instructorUid', 'instructorName', 'status', 'currentSlideIndex', 'revealResults', 'tally', 'totalResponses', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['sessionCode', 'title', 'ficha', 'instructorUid', 'instructorName', 'status', 'currentSlideIndex', 'revealResults', 'tally', 'totalResponses', 'createdAt', 'updatedAt']) &&
        data.sessionCode is string && data.sessionCode.size() >= 6 && data.sessionCode.size() <= 12 && data.sessionCode.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 120 &&
        data.ficha is string && data.ficha.size() >= 4 && data.ficha.size() <= 20 && data.ficha.matches('^[a-zA-Z0-9\\-]+$') &&
        isValidId(data.instructorUid) &&
        data.instructorName is string && data.instructorName.size() >= 2 && data.instructorName.size() <= 100 &&
        data.status in ['activa', 'finalizada'] &&
        data.currentSlideIndex is int && data.currentSlideIndex >= 0 && data.currentSlideIndex <= 20 &&
        data.revealResults is bool &&
        data.tally is list && data.tally.size() == 4 &&
        data.tally[0] is int && data.tally[0] >= 0 && data.tally[0] <= 500 &&
        data.tally[1] is int && data.tally[1] >= 0 && data.tally[1] <= 500 &&
        data.tally[2] is int && data.tally[2] >= 0 && data.tally[2] <= 500 &&
        data.tally[3] is int && data.tally[3] >= 0 && data.tally[3] <= 500 &&
        data.totalResponses is int && data.totalResponses >= 0 && data.totalResponses <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidResponse(data) {
      return data.keys().hasAll(['uid', 'sessionId', 'instructorUid', 'apprenticeName', 'ficha', 'slideIndex', 'selectedOption', 'reflection', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'sessionId', 'instructorUid', 'apprenticeName', 'ficha', 'slideIndex', 'selectedOption', 'reflection', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.sessionId is string && data.sessionId.size() >= 6 && data.sessionId.size() <= 12 && data.sessionId.matches('^[a-zA-Z0-9_\\-]+$') &&
        isValidId(data.instructorUid) &&
        data.apprenticeName is string && data.apprenticeName.size() >= 2 && data.apprenticeName.size() <= 100 &&
        data.ficha is string && data.ficha.size() >= 4 && data.ficha.size() <= 20 && data.ficha.matches('^[a-zA-Z0-9\\-]+$') &&
        data.slideIndex is int && data.slideIndex >= 0 && data.slideIndex <= 20 &&
        data.selectedOption is int && data.selectedOption >= 0 && data.selectedOption <= 3 &&
        data.reflection is string && data.reflection.size() <= 400 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // --- Collection Rules ---
    match /admins/{adminId} {
      allow get: if isVerified() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isVerified() && isValidId(adminId) && isValidAdmin(incoming()) &&
        incoming().uid == adminId &&
        incoming().addedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        isAdmin();
      allow update: if false;
      allow delete: if isVerified() && isValidId(adminId) && isAdmin() && adminId != request.auth.uid;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (
        isAdmin() ||
        (isVerified() && request.auth.uid == userId) ||
        isApprenticeId(userId)
      );
      allow list: if isVerified() && (resource.data.uid == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(userId) && isValidUser(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        incoming().xpPoints <= 500 &&
        (
          (isVerified() && incoming().uid == request.auth.uid && (incoming().role == 'aprendiz' || isAdmin())) ||
          (isApprenticeId(userId) && incoming().role == 'aprendiz')
        );
      allow update: if isValidId(userId) && isValidUser(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            isVerified() &&
            request.auth.uid == userId &&
            incoming().role == existing().role &&
            incoming().xpPoints >= existing().xpPoints &&
            incoming().xpPoints <= existing().xpPoints + 2500 &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'documentType', 'documentNumber',
              'ficha', 'programa', 'onboardingCompleted',
              'completedModules', 'xpPoints', 'level',
              'earnedBadges', 'updatedAt'
            ])
          ) ||
          (
            isApprenticeId(userId) &&
            incoming().role == 'aprendiz' &&
            existing().role == 'aprendiz' &&
            incoming().xpPoints >= existing().xpPoints &&
            incoming().xpPoints <= existing().xpPoints + 2500 &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'documentType', 'documentNumber',
              'ficha', 'programa', 'onboardingCompleted',
              'completedModules', 'xpPoints', 'level',
              'earnedBadges', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerified() && isValidId(userId) && isAdmin();
    }

    match /cohorts/{cohortId} {
      allow get: if isValidId(cohortId);
      allow list: if resource.data.status == 'activa' ||
        (isVerified() && resource.data.instructorUid == request.auth.uid) ||
        isBootstrappedAdmin();
      allow create: if isVerified() && isValidId(cohortId) && isValidCohort(incoming()) &&
        incoming().fichaCode == cohortId &&
        incoming().instructorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerified() && isValidId(cohortId) && isValidCohort(incoming()) &&
        incoming().fichaCode == existing().fichaCode &&
        incoming().instructorUid == existing().instructorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['programa', 'jornada', 'status', 'updatedAt']);
      allow delete: if isVerified() && isValidId(cohortId) && isAdmin() && (
        existing().instructorUid == request.auth.uid || isBootstrappedAdmin()
      );
    }

    match /access_logs/{logId} {
      allow get: if isVerified() && isValidId(logId) && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isVerified() && (resource.data.uid == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(logId) && isValidAccessLog(incoming()) &&
        incoming().createdAt == request.time &&
        (
          (isVerified() && incoming().uid == request.auth.uid) ||
          isApprenticeId(incoming().uid)
        );
      allow update: if false;
      allow delete: if isVerified() && isValidId(logId) && isAdmin();
    }

    match /evaluations/{evalId} {
      allow get: if isVerified() && isValidId(evalId) && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isVerified() && (resource.data.uid == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(evalId) && isValidEvaluation(incoming()) &&
        incoming().createdAt == request.time &&
        (
          (isVerified() && incoming().uid == request.auth.uid) ||
          isApprenticeId(incoming().uid)
        );
      allow update: if false;
      allow delete: if isVerified() && isValidId(evalId) && isAdmin();
    }

    match /app_settings/{settingId} {
      allow get: if isValidId(settingId) && settingId == 'videos';
      allow list: if false;
      allow create: if isVerified() && isValidId(settingId) && settingId == 'videos' &&
        isValidVideoSettings(incoming()) &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerified() && isValidId(settingId) && settingId == 'videos' &&
        isValidVideoSettings(incoming()) &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'anthemVideoId', 'anthemTitle', 'anthemDescription',
          'institutionalVideoId', 'institutionalTitle', 'institutionalDescription',
          'updatedBy', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /sensitization_sessions/{sessionId} {
      allow get: if isValidId(sessionId);
      allow list: if isVerified() && (resource.data.instructorUid == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerified() && isValidId(sessionId) && isValidSession(incoming()) &&
        incoming().sessionCode == sessionId &&
        incoming().instructorUid == request.auth.uid &&
        incoming().status == 'activa' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerified() && isValidId(sessionId) && isValidSession(incoming()) &&
        incoming().sessionCode == existing().sessionCode &&
        incoming().instructorUid == existing().instructorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        (
          (existing().status == 'activa' && incoming().diff(existing()).affectedKeys().hasOnly(['currentSlideIndex', 'revealResults', 'tally', 'totalResponses', 'updatedAt'])) ||
          (existing().status == 'activa' && incoming().status == 'finalizada' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'revealResults', 'tally', 'totalResponses', 'updatedAt'])) ||
          (isBootstrappedAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'currentSlideIndex', 'revealResults', 'tally', 'totalResponses', 'updatedAt']))
        );
      allow delete: if isVerified() && isValidId(sessionId) && isAdmin() && (existing().instructorUid == request.auth.uid || isBootstrappedAdmin());

      match /responses/{responseId} {
        allow get: if isValidId(sessionId) && isValidId(responseId) &&
          exists(/databases/$(database)/documents/sensitization_sessions/$(sessionId)) &&
          (
            (isVerified() && (existing().uid == request.auth.uid || existing().instructorUid == request.auth.uid || isAdmin())) ||
            isApprenticeId(existing().uid)
          );
        allow list: if isVerified() && (
          resource.data.uid == request.auth.uid ||
          resource.data.instructorUid == request.auth.uid ||
          isBootstrappedAdmin()
        );
        allow create: if isValidId(sessionId) && isValidId(responseId) && isValidResponse(incoming()) &&
          incoming().sessionId == sessionId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          (
            (isVerified() && incoming().uid == request.auth.uid) ||
            isApprenticeId(incoming().uid)
          ) &&
          exists(/databases/$(database)/documents/sensitization_sessions/$(sessionId)) &&
          get(/databases/$(database)/documents/sensitization_sessions/$(sessionId)).data.status == 'activa' &&
          incoming().instructorUid == get(/databases/$(database)/documents/sensitization_sessions/$(sessionId)).data.instructorUid;
        allow update: if isValidId(sessionId) && isValidId(responseId) && isValidResponse(incoming()) &&
          incoming().uid == existing().uid &&
          incoming().sessionId == existing().sessionId &&
          incoming().instructorUid == existing().instructorUid &&
          incoming().slideIndex == existing().slideIndex &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            (isVerified() && existing().uid == request.auth.uid) ||
            isApprenticeId(existing().uid)
          ) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['selectedOption', 'reflection', 'updatedAt']) &&
          exists(/databases/$(database)/documents/sensitization_sessions/$(sessionId)) &&
          get(/databases/$(database)/documents/sensitization_sessions/$(sessionId)).data.status == 'activa';
        allow delete: if isVerified() && isValidId(sessionId) && isValidId(responseId) && isAdmin();
      }
    }
  }
}
